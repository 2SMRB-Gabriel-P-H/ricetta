# Copia este archivo a .env y ajusta sólo lo que necesites.
# Ricetta lee .env en cada petición. Las variables del sistema (Apache,
# PHP-FPM, Docker, export del shell) tienen prioridad sobre este archivo.
#
# Protege el archivo: chmod 600 .env

# Base de datos MariaDB/MySQL.
# En XAMPP lo normal es root sin contraseña y la base "ricetta"; la aplicación
# la crea automáticamente si no existe. En producción crea una base y un
# usuario con permisos sólo sobre ella y desactiva AUTO_CREATE.
# RICETTA_DB_HOST=127.0.0.1
# RICETTA_DB_PORT=3306
# RICETTA_DB_NAME=ricetta
# RICETTA_DB_USER=root
# RICETTA_DB_PASSWORD=
# RICETTA_DB_AUTO_CREATE=true

# En Linux también puedes usar el socket local de MariaDB en lugar de TCP.
# RICETTA_DB_SOCKET=/run/mysqld/mysqld.sock

# URL pública completa, sin barra final. Es necesaria para generar enlaces
# de correo y para fijar el Path de la cookie cuando Ricetta no está en la
# raíz del dominio. Sin ella, la cookie usa Path=/.
# En producción debe ser HTTPS.
# RICETTA_PUBLIC_URL=https://ricetta.example.com/ricetta

# Correo transaccional (reservado).
# El registro funciona sin correo. En esta versión PHP el envío SMTP todavía
# no está implementado; estas variables no activan ningún envío.
# RICETTA_SMTP_HOST=smtp.example.com
# RICETTA_SMTP_PORT=587
# RICETTA_SMTP_USER=usuario
# RICETTA_SMTP_PASSWORD=contraseña
# RICETTA_SMTP_SSL=false
# RICETTA_EMAIL_FROM=Ricetta <ricetta@example.com>
